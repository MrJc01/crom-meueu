# Server Configuration
SERVER_PORT=8080
# Modes: NORMAL (Open), WHITELIST (Restricted posting)
SERVER_MODE=NORMAL

# Admin Security
# Generate hash using: ./scripts/gen_pass.sh "your_password"
ADMIN_SECRET_HASH=_your_password_

# Database
DATABASE_URL=postgres://user:password@localhost:5432/meueu?sslmode=disable
